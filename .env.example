# =============================================================================
# ArcusTrader configuration
#
# Copy to `.env` and fill in. Lines starting with `#` are documentation for the
# value above them.
#
# READ THIS FIRST
#   - The defaults here are SAFE: DRY_RUN, no live trading, no order submission.
#   - Live trading requires ALL of: TRADING_MODE=live, LIVE_TRADING=true, and the
#     `--confirm-live` flag on the command line. No combination of variables in
#     this file can arm live trading on its own.
#   - NEVER commit a real `.env`. The variables marked SECRET must come from the
#     process environment / your secret manager, not from version control.
#   - Secrets are never written to logs, the database, or reports. They are
#     registered for value-level redaction at startup.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production

# Arcus endpoints. Mainnet is the default.
#   testnet: https://api.testnet.arcus.xyz  + wss://api.testnet.arcus.xyz/v1/ws
ARCUS_REST_URL=https://api.arcus.xyz
ARCUS_WS_URL=wss://api.arcus.xyz/v1/ws

# Your wallet address and subaccount. The address is a PUBLIC read key on Arcus
# (account channels are unauthenticated), so it is not a secret — but the
# positions it holds are visible to anyone who knows it.
ARCUS_WALLET_ADDRESS=
ARCUS_ACCOUNT_INDEX=0

# SECRET: 32-byte Ed25519 seed, hex (64 chars, optional 0x). This signs every
# mutating request. Generate with:
#   openssl genpkey -algorithm ed25519 -out private.pem
#   openssl pkey -in private.pem -pubout -outform DER | tail -c 32 | xxd -p -c 32
# If ARCUS_API_KEY is set, it MUST match the public half derived from this seed or
# startup fails (this catches the classic "right key, wrong file" mistake).
ARCUS_API_SIGNING_KEY=

# SECRET: the hex public key (64 chars) registered with Arcus. Optional; when set
# it is cross-checked against the signing key.
ARCUS_API_KEY=

# -----------------------------------------------------------------------------
# Safety switches
# -----------------------------------------------------------------------------
# dry_run | shadow | live. `live` additionally requires LIVE_TRADING=true and
# --confirm-live on the command line.
TRADING_MODE=dry_run
LIVE_TRADING=false
ALLOW_ORDER_SUBMISSION=true
# When true (the default), live trading ALSO requires --confirm-live on the command
# line. Set false only for a supervised, ephemeral run: it is the one setting that lets
# a LIVE process start from this file alone.
REQUIRE_EXPLICIT_LIVE_CONFIRMATION=true

# -----------------------------------------------------------------------------
# Risk
#
# These are the ONLY places leverage, per-trade risk and the daily loss limit are
# set. Nothing else in the system can change them.
# -----------------------------------------------------------------------------
# How position size is decided:
#   risk     - size so that hitting the stop loses RISK_PER_TRADE_BPS of equity. The
#              position size adapts to the stop distance; leverage is only a ceiling.
#   leverage - size at exactly MAX_LEVERAGE x equity (bounded by free collateral and the
#              market's own limit). This is what actually uses leverage, so the loss at
#              the stop is bounded instead by MAX_RISK_PER_TRADE_PCT.
SIZING_MODE=risk
MAX_LEVERAGE=2
# leverage mode only: refuse an entry whose stop-out would lose more than this % of
# equity. A percentage (not a dollar amount) so it scales with account size.
MAX_RISK_PER_TRADE_PCT=10
RISK_PER_TRADE_BPS=25
DAILY_LOSS_LIMIT_BPS=100
MAX_NOTIONAL_PCT=30
MAX_OPEN_POSITIONS=1
MAX_MARKETS_PER_ACCOUNT=1
MAX_CONSECUTIVE_LOSSES=3
MAX_DATA_AGE_MS=3000
# Pause NEW entries when equity moves more than this (deposits/withdrawals).
EQUITY_CHANGE_PAUSE_BPS=1000
MIN_FREE_COLLATERAL_USD=50
# Collateral floor as a PERCENTAGE of equity. The effective floor is the larger of this
# and the USD value above, so a fixed dollar floor stops dominating as the account grows.
MIN_FREE_COLLATERAL_PCT=0
WITHDRAWABLE_SAFETY_RESERVE_PCT=20
# Floor on order notional. The market's own minOrderNotional also applies.
MIN_ORDER_NOTIONAL_USD=10
# Maintenance-margin fraction used when a market omits it. Affects only the reported
# liquidation distance and withdrawable balance — never position sizing.
DEFAULT_MAINTENANCE_MARGIN_FRACTION=0.005

# MUST remain 0. Volume is a by-product of real strategy trades; targeting volume
# is wash trading, and a non-zero value makes startup fail.
TARGET_VOLUME_USD=0
# MUST remain false.
ALLOW_AUTO_WITHDRAW=false

# -----------------------------------------------------------------------------
# Strategy (all timeframes are configurable; 1m is NOT permitted as the trigger)
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Strategy mode — pick ONE of two presets
#
#   swing  : 4h trend / 1h structure / 15m trigger, TP1 2R (50% off), hold ~2 days.
#            Low turnover, built for edge per trade. This is the default and is
#            byte-identical to the behaviour before the selector existed.
#   scalp  : 1h trend / 15m structure / 5m trigger, TP1 1R (100% off), hold minutes
#            to hours. Same entry logic, tuned for turnover. More trades means more
#            cost drag per unit of edge — check the backtest numbers before using it.
#
# The preset only fills in values you did NOT set here: anything you set explicitly
# below still wins, so you can override a single knob on top of a preset.
# -----------------------------------------------------------------------------
STRATEGY_MODE=swing

# The presets below change together with STRATEGY_MODE. Leave them as-is unless you
# are deliberately overriding the preset.
TREND_TIMEFRAME=4h
STRUCTURE_TIMEFRAME=1h
TRIGGER_TIMEFRAME=15m
EMA_FAST=9
EMA_MID=21
EMA_SLOW=50
ATR_PERIOD=14
MIN_HISTORY_BARS=250
STOP_ATR_BUFFER=0.5
MAX_EXTENSION_ATR=3.0
MAX_CHASE_ATR=0.25
PULLBACK_ZONE_ATR=1.0
TP1_R_MULTIPLE=2
TP1_CLOSE_PCT=50
TP2_R_MULTIPLE=3
TRAIL_EMA_PERIOD=9
ENTRY_ORDER_TTL_BARS=4

# Swing-confirmation window on the structure timeframe (bars each side).
SWING_LEFT_BARS=2
SWING_RIGHT_BARS=2
# Bars scanned for swing structure / AVWAP anchoring. 0 = derive from MIN_HISTORY_BARS.
STRUCTURE_LOOKBACK_BARS=0
# Fraction of the TP1 distance treated as reachable. This is the expectedMove the cost
# gate compares against total cost — lower it to make the gate stricter.
PROJECTABLE_FRACTION=0.6
# Assumed holding time, used to estimate funding cost.
EXPECTED_HOLD_HOURS=4
# Funding payment interval in hours (Arcus is hourly).
FUNDING_INTERVAL_HOURS=1

# --- Trailing exit ---
# Favourable move in R before the trailing stop may engage.
TRAIL_ACTIVATION_R=0.5
# Buffer placed beyond the trailing EMA, in bps of price.
TRAIL_STOP_BUFFER_BPS=5
# Protective bound for an EMERGENCY market/IOC exit, in bps of the reference price.
EMERGENCY_BOUND_BPS=50

# -----------------------------------------------------------------------------
# Market selection
#
# RWA vs crypto is derived from each market's `category` in GET /v1/markets.
# No market list is ever hardcoded.
# -----------------------------------------------------------------------------
PREFER_RWA=true
ALLOW_CRYPTO=true
# Off-hours entries are refused by default. The session flag comes from the venue
# (`isOutsideRth`); a null flag is treated as UNKNOWN and also refused.
ALLOW_RWA_OFF_HOURS=false
# Optional hard allowlist of symbols (comma-separated). Empty = rank every market.
# Market SELECTION is a strategy parameter: the same strategy over 3 months gave
#   majors (BTC/ETH/SOL/SPY/NVDA/QQQ)  -> net -29.34, PF 0.54, -12.4 bps/volume
#   wider-spread crypto                -> net  +2.41, PF 1.04,  +2.2 bps/volume
# Generate a measured list with: pnpm select-markets
MARKET_ALLOWLIST=
MAX_CANDIDATE_MARKETS=3
# Must be 1. The runtime tracks a single active market; a larger value fails startup
# rather than being silently ignored.
MAX_ACTIVE_MARKET=1
MIN_ORDERBOOK_DEPTH_USD=25000
MAX_SPREAD_BPS=8
MIN_RECENT_VOLUME_USD=100000
MIN_24H_NOTIONAL_USD=250000
OFF_HOURS_SPREAD_MULTIPLIER=0.5
OFF_HOURS_DEPTH_MULTIPLIER=2
MARKET_RERANK_INTERVAL_MS=3600000
MARKET_SWITCH_COOLDOWN_MS=21600000

# --- liquidityScore (0..1; weights are normalised, so only relative size matters) ---
# Band around mid used to measure usable book depth.
DEPTH_BAND_BPS=25
# Depth / 24h volume at (floor x multiple) scores 1.0.
DEPTH_SCORE_SATURATION_MULTIPLE=10
VOLUME_SCORE_SATURATION_MULTIPLE=20
SCORE_WEIGHT_SPREAD=0.3
SCORE_WEIGHT_DEPTH=0.3
SCORE_WEIGHT_VOLUME=0.2
SCORE_WEIGHT_FRESHNESS=0.1
SCORE_WEIGHT_FILL_QUALITY=0.1
# Score for a market whose spread is wider than half MAX_SPREAD_BPS.
SCORE_FILL_QUALITY_PARTIAL=0.5
# Markets quoted per tick purely to inform ranking; orderbook fetches per ranking pass.
MAX_BREADTH_QUOTES=12
MAX_ORDERBOOK_FETCHES=12

# -----------------------------------------------------------------------------
# Cost model (an entry is refused unless expectedMove > totalEstimatedCost)
# -----------------------------------------------------------------------------
ASSUMED_SLIPPAGE_BPS=3
COST_SAFETY_BUFFER_BPS=2
FALLBACK_MAKER_FEE_BPS=1.0
FALLBACK_TAKER_FEE_BPS=3.5

# -----------------------------------------------------------------------------
# Order execution
# -----------------------------------------------------------------------------
MAX_ORDER_NOTIONAL_PCT=30
# Protective bound around a STOP trigger's triggered leg, in bps of the trigger price.
# Separate from EMERGENCY_BOUND_BPS: a flattening exit may need to cross more spread
# than a resting stop's triggered leg.
STOP_TRIGGER_OFFSET_BPS=5
# Must be >= 31: Arcus requires goodTilTime at least one month ahead.
ORDER_GOOD_TIL_DAYS=60
RATE_LIMIT_WEIGHT_BUDGET_PER_MIN=900
MIN_ORDER_POOL_REMAINING=50
# GET /v1/rateLimit is ACCESS-WHITELISTED: it returns 403 for accounts that are
# not whitelisted, unlike the other account reads. With this true (the safe
# default) an unreadable pool blocks ALL new entries. If your account gets a 403,
# set this to false to trade without the pre-emptive pool check — the local weight
# budget and the observed-429 circuit breaker still apply.
REQUIRE_ORDER_POOL_READ=true

# -----------------------------------------------------------------------------
# Lark reporting (Lark Open Platform / Feishu)
#
# The daily report is idempotent on reportDate|wallet|accountIndex, so a PM2
# restart cannot resend it. Delivery failures queue to a local outbox and are
# retried; reporting never blocks the trading loop.
# -----------------------------------------------------------------------------
REPORT_ENABLED=true
REPORT_TIMEZONE=Asia/Shanghai
REPORT_CRON=0 9 * * *
LARK_BASE_URL=https://open.larksuite.com
LARK_CHAT_ID=
# SECRET
LARK_APP_ID=
# SECRET
LARK_APP_SECRET=
LARK_OUTBOX_RETRY_MS=300000

# -----------------------------------------------------------------------------
# Persistence and logging
# -----------------------------------------------------------------------------
DB_PATH=./data/arcustrader.db
LOG_LEVEL=info
# true is for local development only; JSON is the production format.
LOG_PRETTY=false
# Presence of this file blocks all new positions. It survives restarts on purpose.
STOP_FILE=./STOP_TRADING
MAX_MARKET_METADATA_AGE_MS=300000
# Optional read-only status endpoint. 0 = disabled. Returns 200 only when the kill
# switch is clear, reconciliation passes and the loop is ticking; otherwise 503, so a
# monitor can alert on the status code alone. Binds to loopback.
HEALTHCHECK_PORT=0

# -----------------------------------------------------------------------------
# Runtime cadence
# -----------------------------------------------------------------------------
# Decision-loop interval. Lower reacts faster and costs more API weight.
TICK_INTERVAL_MS=5000
# Candle-history refresh interval.
CANDLE_REFRESH_MS=60000
# How often the daily-report gate is evaluated.
REPORT_CHECK_INTERVAL_MS=60000
# Include the consolidated multi-subaccount balance/ROI block in the daily report.
# Equity is summed across subaccounts; fee-tier volume is NOT (Arcus credits it per
# subaccount), while the referral 30d volume IS wallet-level by construction.
REPORT_INCLUDE_ACCOUNT_OVERVIEW=true
# Include affiliate/referral standing (needs a signing key; skipped without one).
REPORT_INCLUDE_AFFILIATE=true
# Highest accountIndex scanned for the overview. Arcus allows 0-9; unused indexes
# return 404 and are skipped, so scanning the whole range is cheap and read-only.
ACCOUNT_OVERVIEW_MAX_INDEX=9
# Health endpoint stale-loop threshold. 0 = derive as max(60s, 12 x TICK_INTERVAL_MS).
HEALTH_STALL_THRESHOLD_MS=0

# -----------------------------------------------------------------------------
# Transport resilience
# -----------------------------------------------------------------------------
# Per-request HTTP timeout.
HTTP_TIMEOUT_MS=10000
# Consecutive 429s before the client stops issuing that class of request.
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=2000
CIRCUIT_BREAKER_MAX_COOLDOWN_MS=60000
# How long a per-subaccount pool reading stays trustworthy before it fails closed.
POOL_STATE_MAX_AGE_MS=300000

# -----------------------------------------------------------------------------
# Lark transport (retry/backoff for report delivery)
# -----------------------------------------------------------------------------
LARK_MAX_ATTEMPTS=4
LARK_BASE_BACKOFF_MS=500
LARK_REQUEST_TIMEOUT_MS=10000
