{
  "name": "arcus-trader",
  "version": "0.1.0",
  "private": true,
  "description": "Arcus Perpetuals pullback trading system. Defaults to DRY_RUN; LIVE requires an explicit flag and a passing preflight.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dry-run": "tsx src/index.ts dry-run",
    "shadow": "tsx src/index.ts shadow",
    "reconcile": "tsx src/index.ts reconcile",
    "preflight": "tsx src/index.ts preflight",
    "report": "tsx src/index.ts report --once",
    "replay": "tsx tools/replay.ts",
    "kill": "tsx src/index.ts kill",
    "reset-kill": "tsx src/index.ts reset-kill",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:safety": "vitest run tests/safety",
    "fetch-docs": "node tools/fetch-arcus-docs.mjs",
    "merge-openapi": "python3 tools/merge-openapi.py",
    "smoke": "node dist/index.js dry-run --ticks 2",
    "backtest": "tsx tools/backtest.ts",
    "select-markets": "tsx tools/select-markets.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "decimal.js": "^10.4.3",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.17.6",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
